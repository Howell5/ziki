{
  "name": "ziki-cloud",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1",
    "types": "wrangler types --include-runtime false",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:page-script": "node --test test/page-script.node.mjs",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "overrides": {
    "sharp": "0.35.4",
    "@cloudflare/vitest-pool-workers": { "miniflare": "5.20260911.0-alpha", "wrangler": "$wrangler" }
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "5.20260911.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "4.131.1"
  },
  "dependencies": {
    "better-auth": "1.7.4"
  }
}
