{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ziki-cloud-local",
  "main": "src/index.ts",
  // Latest published workerd at implementation time; 2026-09-13 is not supported locally yet.
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 0.1, "logs": { "invocation_logs": false } },
  "vars": { "ENVIRONMENT": "local", "CLOUD_ENABLED": "false", "AUTH_ORIGIN": "http://127.0.0.1:8787" },
  "secrets": { "required": ["BETTER_AUTH_SECRET"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "ziki-cloud-local",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations",
    "remote": false
  }]
}
