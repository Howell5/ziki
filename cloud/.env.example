# Ziki Cloud 配置交接 / local environment template
# 复制本文件为同目录 .env 后填写；不要提交 .env，也不要把密钥发到聊天里。
# 在 cloud/ 执行：cp -n .env.example .env && chmod 600 .env
# .env 与 .dev.vars 二选一：若存在 .dev.vars，Wrangler 会优先读取它。
# 以下分为「当前已接入」和「后续预留」。留空的凭证不会启用对应服务。
# 填完告诉我即可；无需你自行部署、创建 D1 或购买 Stripe 套餐商品。

# ── 1. 当前已接入：本地认证基础 ────────────────────────────
# 本地联调保持此地址；api.getziki.com 的 DNS/Worker 部署完成后才切换远端配置。
ENVIRONMENT=local
AUTH_ORIGIN=http://127.0.0.1:8787
AUTH_ENABLED=true
# 云识别/支付尚未完成，保持 false；填密钥不代表自动允许付费调用。
CLOUD_ENABLED=false

# 必填：独立的会话加密/签名随机串（不是服务商 API Key）。
# 在终端执行 openssl rand -hex 32，把生成结果粘贴到等号后。
# 不要使用示例字串、账号密码或复用其他服务的密钥。
BETTER_AUTH_SECRET=

# ── 2. 当前已接入：Google 登录（暂时没有可留空）───────────
# 获取：https://console.cloud.google.com/apis/credentials
# 为 Ziki 创建 OAuth client，类型选 Web application，而不是 Desktop app。
# Authorized JavaScript origin：http://127.0.0.1:8787
# Authorized redirect URI：http://127.0.0.1:8787/api/auth/callback/google
# 计划远端 origin：https://api.getziki.com
# 计划远端 redirect URI：https://api.getziki.com/api/auth/callback/google
# 远端尚未部署。Google 控制台可预填，但不能只填域名作为 redirect URI。
# 配置 consent screen；若应用处于测试状态，把你的 Google 账号加入测试用户。
# 文档：https://better-auth.com/docs/authentication/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── 3. 当前已接入：邮箱验证码 ─────────────────────────────
# 使用 Cloudflare Email Service 的 EMAIL binding，不需要额外邮件 API Key。
# 先保持 false；Google 登录不依赖这个开关。
# 本地改 true 只发送到 Wrangler 邮件模拟器，不会送达真实收件箱。
# 真实邮件需要在 Cloudflare 开通 Email Service sending 并验证发信域名；
# 只开通 Email Routing 转发不够。部署时我来核对账号能力与域名状态。
# 发件人先沿用下方值；若要修改，还需同步 wrangler 的 allowed_sender_addresses。
# 文档：https://developers.cloudflare.com/email-service/get-started/send-emails/
EMAIL_LOGIN_ENABLED=false
EMAIL_FROM=login@getziki.com

# ── 4. 后续预留：百炼新加坡云识别/整理（请先准备）──────────
# 这些变量尚未接入 Worker，当前填写只是安全交接，不会触发模型请求。
# 在阿里云 Model Studio / 百炼控制台选择 Singapore / 新加坡区域，
# 创建专供 Ziki Cloud 使用的 API Key，并复制该区域对应 Workspace ID。
# 不要填阿里云 AccessKey ID/Secret，也不要复制客户端个人 BYOK Key。
# Key 与 Workspace 必须来自同一区域；后续由服务端使用，不会放入 App。
# 获取说明：https://www.alibabacloud.com/help/en/model-studio/get-api-key
BAILIAN_API_KEY=
BAILIAN_WORKSPACE_ID=
# 后续真实模型验收的美元总预算，默认 0 = 尚未授权任何付费测试。
# 可填写你允许的正数上限；当前只是交接记录，尚非自动计费/限额实现。
MODEL_TEST_BUDGET_USD=0

# ── 5. 后续预留：英国 Stripe 账户，USD（现在可全部留空）───
# 尚未接入支付代码；只接受测试环境/沙盒凭证，不填 sk_live_ 密钥。
# 在 https://dashboard.stripe.com/ 切换到测试环境/沙盒 → API keys。
# 文档：https://docs.stripe.com/keys
STRIPE_SECRET_KEY=
# Webhook endpoint signing secret，通常以 whsec_ 开头，不是 API Key。
# staging webhook 尚未部署：先留空，配置 endpoint 时再填写。
STRIPE_WEBHOOK_SECRET=
# 月订阅的测试 Price ID（price_...），不是 Product ID（prod_...）。
# 月费与额度尚未确认：先留空，确认后我来创建 USD 月付测试价格。
STRIPE_PRICE_MONTHLY_ID=

# 无需填写 CLOUDFLARE_API_TOKEN / 数据库密码 / SMTP 密码 / OpenAI Key。
# D1、EMAIL 是 Cloudflare 资源绑定，不是能填进 .env 的普通字符串。
# .env 只供本地读取；真实部署时再分离普通变量与 Workers secrets。
# 不要把整份 .env 上传成公开配置、打进客户端，或放进 website/public。
